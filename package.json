{
  "name": "boomboomroom",
  "version": "0.1.0",
  "private": true,
  "description": "Boom Boom Room — multiplayer AI generative music party",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:realtime": "tsx watch realtime/index.ts",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:all": "concurrently -k -n web,rt,wk -c magenta,cyan,yellow \"npm run dev\" \"npm run dev:realtime\" \"npm run dev:worker\"",
    "build": "next build",
    "start": "next start",
    "start:realtime": "tsx realtime/index.ts",
    "start:worker": "tsx worker/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "house:assets": "node scripts/generate-house-assets.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
