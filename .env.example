# --- Public (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://cokbfdbzvunlrssmivng.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
NEXT_PUBLIC_ROOM_SLUG=main

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=change-me-to-a-long-random-string
MODERATOR_SECRET=change-me-moderator-token

# fal.ai — server-only. When unset, generation runs in mock mode.
FAL_KEY=
CHARACTER_MODEL_ENDPOINT=fal-ai/flux-pro/kontext

# Redis — Railway worker/realtime private network (or local docker-compose).
# Not required on Vercel; the worker claims queued generation_jobs from Postgres.
REDIS_URL=redis://127.0.0.1:6379

# Public origin of the Next.js app (webhooks + CORS)
APP_URL=http://localhost:3000

# Optional override if webhooks should hit a tunnel
WEBHOOK_BASE_URL=

# Realtime listen port (Railway injects PORT)
PORT=4000
REALTIME_PORT=4000

# Room
ROOM_SLUG=main
MAX_PARTICIPANTS=20

# Worker
HOUSE_ASSET_DIR=./public/house
DEV_STORE_PATH=./.data/store.json
